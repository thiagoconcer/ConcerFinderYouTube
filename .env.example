# ConcerFinder, copie para .env e preencha com os dados do projeto Supabase.
# Regra do SKILL.md: apenas chaves públicas usam o prefixo VITE_.

# Project URL (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable / anon key, pública por design, protegida por RLS
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

